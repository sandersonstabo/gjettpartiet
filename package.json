{
  "name": "gjettpartiet",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "data:politician-images": "deno run --allow-net=data.stortinget.no --allow-read=src/lib/assets/politicians --allow-write=src/lib/assets/politicians .scripts/fetch-politician-images.ts",
    "data:politician-images:avif": "deno run --node-modules-dir=auto --allow-read=src/lib/assets/politicians --allow-write=src/lib/assets/politicians --allow-env --allow-sys --allow-ffi .scripts/convert-politician-images-to-avif.ts",
    "data:politicians": "deno run --allow-net=data.stortinget.no --allow-write=src/lib/data/politicians.ts .scripts/fetch-politicians.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@selemondev/svgl-svelte": "^2.8.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "effect": "^4.0.0-beta.64",
    "mode-watcher": "^1.1.0",
    "svelte-effect-runtime": "^1.4.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^24",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^1.0.0-beta.22",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "layerchart": "2.0.0-next.48",
    "paneforge": "^1.0.2",
    "postgres": "^3.4.9",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "svelte-sonner": "^1.1.1",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.0.7"
  }
}
